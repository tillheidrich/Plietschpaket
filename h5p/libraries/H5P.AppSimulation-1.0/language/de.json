                {
                  "label": "Detail",
                  "description": "Optionale zweite Zeile, z. B. „Tippe auf das Zahnrad.“"
                },
                {
                  "label": "Art des Schritts",
                  "options": [
                    {
                      "label": "Aufgabe: richtige Stelle antippen"
                    },
                    {
                      "label": "Info: Bereich hervorheben, weiter mit „Weiter“"
                    },
                    {
                      "label": "Hinweis: wichtige Anmerkung, weiter mit „Weiter“"
                    },
                    {
                      "label": "Erkunden: mehrere Hinweise auf dem Bildschirm, weiter mit „Weiter“"
