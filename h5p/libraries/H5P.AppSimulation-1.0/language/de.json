        {
          "label": "Kennzeichnung über dem Titel",
          "description": "Kurzes Etikett, z. B. Produkt und „Training“.",
          "default": "Training"
        },
        {
          "label": "Untertitel",
          "description": "z. B. Plattform und Sprache: „iOS · Deutsch“."
        },
        {
          "label": "Einleitung",
          "description": "Ein bis zwei Sätze: Was kann die lernende Person danach?"
        },
        {
          "label": "Logo",
          "description": "Wird in der Seitenleiste gezeigt (PNG/JPG, hell auf dunklem Grund)."
        }
      ]
    },
    {
