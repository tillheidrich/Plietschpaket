                                "label": "Rechteck"
                              },
                              {
                                "label": "Kreis/Ellipse"
                              }
                            ]
                          },
                          {
                            "label": "Links (0–1)"
                          },
                          {
                            "label": "Oben (0–1)"
                          },
                          {
                            "label": "Breite (0–1)"
                          },
                          {
                            "label": "Höhe (0–1)"
                          }
                        ]
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
